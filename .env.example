# Local `next dev` uses data/budget.db automatically.
# Vercel cannot persist a SQLite file. Use Turso (hosted SQLite) instead:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Required to lock the app behind a login
AUTH_USERNAME=cedric
AUTH_PASSWORD=change-this
AUTH_SECRET=generate-a-long-random-string
